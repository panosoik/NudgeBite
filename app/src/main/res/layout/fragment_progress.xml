<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progress"
            android:textColor="@color/nb_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <com.panagiotisoikonomou.nudgebite.ui.components.SegmentedToggle
            android:id="@+id/span_select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:id="@+id/period_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/prev_month_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="‹"
                android:textColor="@color/nb_text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/month_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/nb_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/next_month_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="›"
                android:textColor="@color/nb_text_primary"
                android:textSize="20sp" />

        </LinearLayout>

        <com.panagiotisoikonomou.nudgebite.ui.components.SingleSelectList
            android:id="@+id/week_pill_select"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:id="@+id/week_summary_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/quality_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/dot_active" />

            <TextView
                android:id="@+id/quality_summary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/nb_primary_green"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/quality_completeness_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:textColor="@color/nb_text_secondary"
            android:textSize="12sp" />

        <com.panagiotisoikonomou.nudgebite.ui.components.WeekDotRow
            android:id="@+id/week_dot_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp" />

        <com.panagiotisoikonomou.nudgebite.ui.components.MonthDotRow
            android:id="@+id/month_dot_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/review_note_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_note"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/review_note_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/nb_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/review_note_improvement_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/nb_text_primary"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/goals_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/goals_header_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/nb_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/goals_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/diet_quality_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="10dp"
                android:text="DIET QUALITY"
                android:textColor="@color/nb_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.panagiotisoikonomou.nudgebite.ui.components.ChartCard
                android:id="@+id/overall_chart_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.panagiotisoikonomou.nudgebite.ui.components.SingleSelectList
                android:id="@+id/food_group_select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <com.panagiotisoikonomou.nudgebite.ui.components.ChartCard
                android:id="@+id/group_chart_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
